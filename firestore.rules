rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role lookup helper from /usuarios/{uid}
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@uppa.ar' ||
        request.auth.token.email == 'gastonrobertogimenez@gmail.com' ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          (getUserData().rol == 'administrador' || getUserData().rol == 'admin'))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================
    // 1. USUARIOS COLLECTION: usuarios/{userId}
    // ========================================================
    // - Propietario o administrador
    match /usuarios/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && (!('rol' in request.resource.data) || request.resource.data.rol == resource.data.rol || isAdmin())) || isAdmin();
      allow delete: if isAdmin();

      // Tokens FCM para notificaciones push
      match /tokens/{token} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Backward-compatibility for legacy /users
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ========================================================
    // 2. REPORTES COLLECTION: reportes/{reporteId}
    // ========================================================
    // - Reportes en tiempo real: Solo autenticados pueden crear y leer.
    // - Propietario o administrador pueden editar/modificar estado o borrar.
    match /reportes/{reporteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.usuarioId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmaciones', 'votos', 'estado']) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.usuarioId == request.auth.uid);
    }

    // ========================================================
    // 3. SALAS DE CHAT: salas_chat/{salaId}/mensajes/{mensajeId}
    // ========================================================
    // - Solo usuarios autenticados pueden participar.
    // - Borrar mensaje propio o moderador/administrador.
    match /salas_chat/{salaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /mensajes/{mensajeId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.usuarioId == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.usuarioId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportado', 'reportesCount']) ||
          isAdmin()
        );
        allow delete: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      }
    }

    // ========================================================
    // 4. SOLICITUDES DE TRANSPORTE: solicitudes_transporte/{solicitudId}
    // ========================================================
    // - Solo usuario creador, chofer asignado o administrador
    match /solicitudes_transporte/{solicitudId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.pasajeroId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.pasajeroId == request.auth.uid ||
        resource.data.choferId == request.auth.uid ||
        resource.data.choferId == null ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.pasajeroId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 5. HABILITACIONES DE CHOFER: habilitaciones_chofer/{habilitacionId}
    // ========================================================
    // - Chofer solicita habilitación; solo Administrador aprueba con clave "0608".
    match /habilitaciones_chofer/{habilitacionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ========================================================
    // 6. ANALYTICS & METRICAS: analytics/{docId}
    // ========================================================
    match /analytics/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ========================================================
    // 7. CODIGOS DE HABILITACION UNICOS: codigos_habilitacion/{codigo}
    // ========================================================
    // - Administrador genera códigos únicos de 6 caracteres
    // - Chofer canjea código y actualiza usado: true
    match /codigos_habilitacion/{codigo} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
